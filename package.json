{
  "name": "telemetry-prs",
  "version": "0.2.0",
  "private": true,
  "description": "Catch missing OpenTelemetry instrumentation in TypeScript/Node.js pull requests — fast, static, vendor-neutral, and 100% inside your CI.",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.cjs",
  "bin": {
    "telemetry-prs": "dist/cli.cjs"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.ts",
    "cli": "node src/cli.ts"
  },
  "keywords": [
    "opentelemetry",
    "observability",
    "telemetry",
    "github-action",
    "linter",
    "typescript",
    "sre"
  ],
  "dependencies": {
    "@actions/core": "^1.11.1",
    "@actions/github": "^6.0.1",
    "minimatch": "^10.0.1",
    "typescript": "^5.8.2",
    "yaml": "^2.7.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "esbuild": "^0.25.1"
  },
  "engines": {
    "node": ">=20"
  }
}
